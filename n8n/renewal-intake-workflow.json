        "responses": {
          "values": [
            {
              "content": "=Draft a short, professional email requesting missing renewal documents from a client.\n\nClient:\n{{ $('Sample Renewal Package').first().json.client_name }}\n\nMissing documents:\n{{ $json.missing_documents.join(', ') }}\n\nThe email should:\n- clearly state which document(s) are missing\n- ask the client to send them so the renewal intake can continue\n- be polite and concise\n- not invent any deadlines, names, or details\n\nReturn only the email draft."
            }
          ]
        },
        "builtInTools": {},
